# Тестер стенда (scripts/stand_tester.py). Реальный файл — data-tester/tester.env, ТОЛЬКО на сервере, не в git.
# api_id / api_hash: https://my.telegram.org → API development tools (один раз, с любого аккаунта).
TG_API_ID=
TG_API_HASH=
# @username тестового бота стенда (НЕ прод-бота)
TESTER_BOT=@
# id тестовой группы для `to group` (найти: tester chats a)
TESTER_GROUP=
# паузы и ожидание, секунды
TESTER_GAP=2
TESTER_TIMEOUT=90
TESTER_SETTLE=4
