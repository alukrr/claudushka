# Скопировать в infra/edge/.env (в git не попадает) и вписать свои хосты.
# DNS (A/AAAA) этих имён должен указывать на сервер ДО запуска — иначе Caddy упрётся в лимиты Let's Encrypt.
DND_PUBLIC_HOST=dnd.alukr.de
CLAUDUSHKA_PUBLIC_HOST=claudushka.alukr.de
CLAUDUSHKA_TEST_PUBLIC_HOST=claudushka-test.alukr.de
