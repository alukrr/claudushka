TELEGRAM_BOT_TOKEN=your-telegram-bot-token
ANTHROPIC_API_KEY=your-anthropic-api-key
# Пул api.apitoken.sale (даёт скидку к прайсу Anthropic) — без этой переменной бот
# идёт напрямую в Anthropic по официальным ценам.
ANTHROPIC_BASE_URL=https://router.apitoken.sale
TAVILY_API_KEY=your-tavily-api-key
GEMINI_API_KEY=your-gemini-api-key

# WhatsApp
META_API_KEY=your-meta-api-key
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WEBHOOK_VERIFY_TOKEN=your-secret-token
# App Secret приложения Meta (Meta for Developers → твоё приложение → Настройки →
# Основное → "Секрет приложения"). Используется для проверки подписи X-Hub-Signature-256
# на входящих вебхуках. Без него whatsapp.py стартует в fail-closed режиме и отклоняет
# все POST на /webhook/whatsapp с 403 — добавь секрет ДО деплоя, иначе WhatsApp замолчит.
WHATSAPP_APP_SECRET=your-meta-app-secret

# Nano Banana (необязательно): модель и уровень thinking (minimal/medium/high)
# BANANA_MODEL=gemini-nano-banana-2.1
# BANANA_THINKING_LEVEL=medium

# Поисковый провайдер (docs/claude/native-search.md): tavily | gemini (Google Search через Gemini). Необязательно.
# SEARCH_PROVIDER_FALLBACK=gemini            # когда нативный поиск недоступен (фолбэк Claude / пул отклонил)
# SEARCH_PROVIDER_FREE=tavily                # бесплатный режим и /search
# SEARCH_GEMINI_MODEL=gemini-3.8-flash

# Фолбэк Claude -> Gemini при сбоях пула (docs/claude/model-fallback.md). Всё необязательно.
# FALLBACK_ENABLED=1                         # 0 = выключено, поведение как до фолбэка
# FALLBACK_MODEL=gemini-3.8-flash            # для чатов на Sonnet/Opus/Fable
# FALLBACK_MODEL_CHEAP=gemini-3.1-flash-lite # для Haiku-чатов и служебных вызовов
# FALLBACK_STICKY_SECONDS=300                # сколько секунд после сбоя Claude сразу идти на Gemini
