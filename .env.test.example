# Шаблон .env.test для тестового стенда (claudushka-test / claudushka-wa-test).
# Подробности — docs/claude/staging.md. Сам .env.test в git не попадает (.gitignore).
#
# ЕДИНСТВЕННОЕ обязательное отличие от боевого .env — TELEGRAM_BOT_TOKEN: токен
# ОТДЕЛЬНОГО тестового бота, который Алексей создаёт у @BotFather сам и держит у себя
# (в репозиторий и в чат с агентом токен не передавать).
#
# Все остальные ключи ниже — ТЕ ЖЕ значения, что в боевом .env: свой Anthropic-ключ,
# свой WhatsApp Business номер и т.д. заводить для стенда не нужно и незачем. Это значит
# стенд тратит тот же баланс пула и может слать РЕАЛЬНЫЕ сообщения через тот же WhatsApp
# номер, что и прод — так и задумано (проверяется вся цепочка), но держать это в уме.

TELEGRAM_BOT_TOKEN=test-bot-token-from-botfather
ANTHROPIC_API_KEY=same-as-prod-.env
# Без этой строки бот идёт напрямую в Anthropic, минуя пул api.apitoken.sale —
# цены/скидка пула и общий с прод-стендом баланс перестают действовать молча.
ANTHROPIC_BASE_URL=same-as-prod-.env
TAVILY_API_KEY=same-as-prod-.env
GEMINI_API_KEY=same-as-prod-.env

# WhatsApp — все значения те же, что в боевом .env (один WhatsApp Business номер на
# прод и стенд, тестовый payload шлёт curl с сервера, WA-ответ уходит через боевой Meta).
META_API_KEY=same-as-prod-.env
WHATSAPP_PHONE_NUMBER_ID=same-as-prod-.env
WEBHOOK_VERIFY_TOKEN=same-as-prod-.env
WHATSAPP_APP_SECRET=same-as-prod-.env

# Только стенд (docs/claude/staging-checklist-safety-unblock.md): строка в тексте запроса → вызов ведёт себя как safety-блок
# провайдера. В боевом .env НЕ задавать.
SAFETY_TEST_MARKER=

# Мини-приложение настроек (docs/claude/miniapp.md). Необязательно: без MINIAPP_PUBLIC_URL веб-сервер не стартует, меню-кнопка не ставится,
# /settings отвечает «мини-приложение не настроено». Не секрет. Менять .env -> docker compose up -d --force-recreate (не restart).
# MINIAPP_PUBLIC_URL=https://claudushka-test.alukr.de
# MINIAPP_PORT=8090                          # порт внутри контейнера; наружу НЕ публикуется (только через edge-caddy)
# MINIAPP_INITDATA_MAX_AGE=3600              # сколько секунд подпись initData считается свежей
# MINIAPP_MAIN_APP=1                        # 1 — в BotFather включён Main Mini App с этим URL: /settings в группе открывает приложение прямо в группе
#                                          # (t.me/<bot>?startapp=…); без флага — ссылка в личку, как раньше (docs/claude/miniapp.md)

# Параллельная обработка апдейтов (docs/claude/api-errors.md). Необязательно: без переменных работают дефолты (16 и 32).
# MAX_CONCURRENT_UPDATES=16                  # апдейтов одновременно (разные чаты параллельно, один чат — по очереди); 1 = по одному, аварийный откат
# THREAD_POOL_WORKERS=32                     # размер пула потоков для to_thread (SQLite-обёртки, sync-вызовы модели, ffmpeg)

# Пополнение Stars (docs/claude/billing.md). Необязательно; на стенде платить 1-10 звёзд тестовому боту — STARS_PACKS=1,5,10 удобнее дефолта.
# STARS_USD_RATE=0.010
# STARS_PACKS=1,5,10
